
class Solution {
public:
    #define int long long
    const int MOD = 1e9 + 7;

    vector<vector<int>> adj;
    vector<int> sz;

    int dfs(int u) {
        sz[u] = 1;

        for (auto v : adj[u]) {
            dfs(v);
            sz[u] += sz[v];
        }

        return sz[u];
    }

    int fact(int n) {
        int ans = 1;

        for (int i = 1; i <= n; i++) {
            ans = (ans * i) % MOD;
        }

        return ans;
    }

    int bigmod(int a, int b) {
        int ans = 1;

        while (b > 0) {
            if (b & 1) {
                ans = (ans * a) % MOD;
            }

            a = (a * a) % MOD;
            b /= 2;
        }

        return ans;
    }

    int waysToBuildRooms(vector<int>& prevRoom) {
        int n = prevRoom.size();

        adj.assign(n, {});
        sz.assign(n, 0);

        for (int i = 1; i < n; i++) {
            adj[prevRoom[i]].push_back(i);
        }

        dfs(0);

        int prod = 1;

        for (int i = 0; i < n; i++) {
            prod = (prod * sz[i]) % MOD;
        }

        return (fact(n) * bigmod(prod, MOD - 2)) % MOD;
    }
};
